diff --git c/src/Filee.Core/Conversion/OutputCommit.cs i/src/Filee.Core/Conversion/OutputCommit.cs
new file mode 100644
index 0000000..bc42aeb
--- /dev/null
+++ i/src/Filee.Core/Conversion/OutputCommit.cs
@@ -0,0 +1,315 @@
+// Final outputs are written into a hidden staging folder next to their final path and only moved into place, path by
+// path, once the conversion succeeded. A failed or cancelled conversion leaves nothing at the final paths, an
+// existing file is replaced atomically or not at all, and the source of a job is never replaced (also not through
+// another spelling of its path: Unicode normalization, case, linked folders).
+
+using System.Collections.Concurrent;
+using System.Runtime.InteropServices;
+using Filee.Core.Presets;
+
+namespace Filee.Core.Conversion;
+
+/// <summary>A staged output that could not be moved to its final path.</summary>
+public sealed class OutputCommitException(string errorKey, string message, Exception? inner = null) : IOException(message, inner)
+{
+    /// <summary><c>error.output_exists</c>, <c>error.output_is_source</c> or <c>error.output_commit_failed</c>.</summary>
+    public string ErrorKey { get; } = errorKey;
+}
+
+/// <summary>Moves staged files and folders to their final paths.</summary>
+public static class OutputCommit
+{
+    /// <summary>Prefix of staging folder names (followed by 8 hex digits).</summary>
+    public const string StagingPrefix = ".filee-out-";
+
+    private static readonly ConcurrentDictionary<string, string> Finals = new(StringComparer.Ordinal);
+
+    /// <summary>
+    /// The path a staged output will be moved to, or <paramref name="path"/> itself when it isn't staged. For engines
+    /// that write links relative to where the result ends up (next to the source or not).
+    /// </summary>
+    public static string FinalPathOf(string path) => Finals.TryGetValue(path, out var final) ? final : path;
+
+    internal static void Track(string staged, string final) => Finals[staged] = final;
+
+    internal static void Untrack(string staged) => Finals.TryRemove(staged, out _);
+
+    /// <summary>True for a folder name made by <see cref="CreateStagingFolder"/>.</summary>
+    public static bool IsStagingFolderName(string name) =>
+        name.Length == StagingPrefix.Length + 8 && name.StartsWith(StagingPrefix, StringComparison.Ordinal)
+        && name[StagingPrefix.Length..].All(Uri.IsHexDigit);
+
+    /// <summary>Creates a new hidden staging folder in <paramref name="directory"/>.</summary>
+    public static string CreateStagingFolder(string directory)
+    {
+        while (true)
+        {
+            var path = Path.Combine(directory, StagingPrefix + Guid.NewGuid().ToString("N")[..8]);
+            if (Directory.Exists(path) || File.Exists(path))
+                continue;
+            Directory.CreateDirectory(path).Attributes |= FileAttributes.Hidden;
+            return path;
+        }
+    }
+
+    /// <summary>
+    /// Moves <paramref name="staged"/> (a file or a folder) to <paramref name="final"/>. With <paramref name="overwrite"/>
+    /// an existing file is replaced in one step and an existing folder receives the staged files (others stay);
+    /// otherwise an existing path fails with <c>error.output_exists</c>.
+    /// </summary>
+    public static void Move(string staged, string final, bool overwrite, IReadOnlyList<string> sources)
+    {
+        var isDirectory = Directory.Exists(staged);
+        var existing = Exists(final);
+        if (!existing)
+        {
+            if (!TryRenameExclusive(staged, final, isDirectory))
+                throw new OutputCommitException("error.output_exists", $"{final} appeared while converting.");
+            return;
+        }
+        if (!overwrite)
+            throw new OutputCommitException("error.output_exists", $"{final} already exists.");
+        if (IsSource(final, sources))
+            throw new OutputCommitException("error.output_is_source", $"{final} is a source file of this job.");
+
+        if (!isDirectory)
+        {
+            Rename(staged, final);
+            return;
+        }
+        if (!Directory.Exists(final) || new DirectoryInfo(final).Attributes.HasFlag(FileAttributes.ReparsePoint))
+            throw new OutputCommitException("error.output_exists", $"{final} is in the way of the extracted folder.");
+        // Merge like Filee always did: each entry replaced on its own, the folder's other files are kept.
+        foreach (var entry in Directory.EnumerateFileSystemEntries(staged))
+            Move(entry, Path.Combine(final, Path.GetFileName(entry)), overwrite, sources);
+        TryDelete(staged);
+    }
+
+    /// <summary>
+    /// True when <paramref name="path"/> is the same file system object as one of <paramref name="sources"/> (or what
+    /// a source link points to). Compares device and inode numbers where the OS has them, full paths elsewhere.
+    /// </summary>
+    public static bool IsSource(string path, IReadOnlyList<string> sources)
+    {
+        if (Unix.Identity(path, follow: false) is { } target)
+        {
+            foreach (var source in sources)
+                if (Unix.Identity(source, follow: false) == target || Unix.Identity(source, follow: true) == target)
+                    return true;
+            return false;
+        }
+        var full = Path.GetFullPath(path);
+        return sources.Any(s => string.Equals(Path.GetFullPath(s), full, StringComparison.OrdinalIgnoreCase));
+    }
+
+    public static void TryDelete(string path)
+    {
+        try
+        {
+            if (Directory.Exists(path))
+                Directory.Delete(path, recursive: true);
+            else if (File.Exists(path))
+                File.Delete(path);
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { }
+    }
+
+    private static bool Exists(string path) =>
+        File.Exists(path) || Directory.Exists(path) || new FileInfo(path).LinkTarget is not null;
+
+    private static void Rename(string from, string to)
+    {
+        if (OperatingSystem.IsWindows())
+        {
+            try { File.Move(from, to, overwrite: true); }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+            { throw new OutputCommitException("error.output_commit_failed", ex.Message, ex); }
+            return;
+        }
+        if (Unix.rename(from, to) != 0)
+            throw Failed(to);
+    }
+
+    /// <summary>Renames unless <paramref name="to"/> exists, atomically. False when it exists.</summary>
+    private static bool TryRenameExclusive(string from, string to, bool isDirectory)
+    {
+        if (OperatingSystem.IsWindows())
+        {
+            try
+            {
+                if (isDirectory) Directory.Move(from, to);
+                else File.Move(from, to, overwrite: false);
+                return true;
+            }
+            catch (IOException) when (Exists(to)) { return false; }
+            catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
+            { throw new OutputCommitException("error.output_commit_failed", ex.Message, ex); }
+        }
+
+        int result, errno;
+        try
+        {
+            result = OperatingSystem.IsMacOS() ? Unix.renamex_np(from, to, Unix.RenameExclMac)
+                : Unix.renameat2(Unix.AtFdCwd, from, Unix.AtFdCwd, to, Unix.RenameNoReplaceLinux);
+            errno = Marshal.GetLastPInvokeError();
+        }
+        catch (EntryPointNotFoundException)
+        {
+            (result, errno) = (-1, Unix.ENOSYS);
+        }
+        if (result == 0)
+            return true;
+        if (errno == Unix.EEXIST)
+            return false;
+        if (!isDirectory && (errno == Unix.ENOTSUP || errno == Unix.EINVAL || errno == Unix.ENOSYS))
+        {
+            // No exclusive rename on this file system: a hard link is just as exclusive for a file.
+            if (Unix.link(from, to) == 0)
+            {
+                Unix.unlink(from);
+                return true;
+            }
+            if (Marshal.GetLastPInvokeError() == Unix.EEXIST)
+                return false;
+        }
+        throw Failed(to);
+    }
+
+    private static OutputCommitException Failed(string to)
+    {
+        var errno = Marshal.GetLastPInvokeError();
+        return new OutputCommitException("error.output_commit_failed", $"Could not move the result to {to}: {Marshal.GetPInvokeErrorMessage(errno)} (errno {errno}).");
+    }
+
+    private static class Unix
+    {
+        public const uint RenameExclMac = 0x4;
+        public const uint RenameNoReplaceLinux = 0x1;
+        public const int AtFdCwd = -100;
+        public static readonly int EEXIST = 17;
+        public static readonly int EINVAL = 22;
+        public static readonly int ENOSYS = OperatingSystem.IsMacOS() ? 78 : 38;
+        public static readonly int ENOTSUP = OperatingSystem.IsMacOS() ? 45 : 95;
+
+        [DllImport("libc", SetLastError = true)] public static extern int rename(string from, string to);
+        [DllImport("libc", SetLastError = true)] public static extern int renamex_np(string from, string to, uint flags);
+        [DllImport("libc", SetLastError = true)] public static extern int renameat2(int fromDir, string from, int toDir, string to, uint flags);
+        [DllImport("libc", SetLastError = true)] public static extern int link(string from, string to);
+        [DllImport("libc", SetLastError = true)] public static extern int unlink(string path);
+        [DllImport("libc", SetLastError = true, EntryPoint = "lstat")] private static extern int lstat_arm64(string path, byte[] buf);
+        [DllImport("libc", SetLastError = true, EntryPoint = "lstat$INODE64")] private static extern int lstat_x64(string path, byte[] buf);
+        [DllImport("libc", SetLastError = true, EntryPoint = "stat")] private static extern int stat_arm64(string path, byte[] buf);
+        [DllImport("libc", SetLastError = true, EntryPoint = "stat$INODE64")] private static extern int stat_x64(string path, byte[] buf);
+
+        /// <summary>(st_dev, st_ino) on macOS; null elsewhere or when the path is missing.</summary>
+        public static (long Device, ulong Inode)? Identity(string path, bool follow)
+        {
+            if (!OperatingSystem.IsMacOS())
+                return null;
+            // struct stat (64-bit inodes): dev_t st_dev at 0 (int32), ino_t st_ino at 8 (uint64); 144 bytes.
+            var buf = new byte[256];
+            var x64 = RuntimeInformation.ProcessArchitecture == Architecture.X64;
+            var result = follow ? (x64 ? stat_x64(path, buf) : stat_arm64(path, buf))
+                : (x64 ? lstat_x64(path, buf) : lstat_arm64(path, buf));
+            return result != 0 ? null : (BitConverter.ToInt32(buf, 0), BitConverter.ToUInt64(buf, 8));
+        }
+    }
+}
+
+/// <summary>
+/// Hands out staged paths for one source file (or one merged output) and moves them to their final paths on commit.
+/// </summary>
+internal sealed class StagedOutputs(Action<string>? onStaging)
+{
+    private sealed record Entry(string Final, string StageDir, string Staged);
+
+    private readonly List<Entry> _entries = [];
+
+    /// <summary>Called when a final path was reserved: returns where the converter writes instead.</summary>
+    public string Stage(string final)
+    {
+        var stageDir = OutputCommit.CreateStagingFolder(Path.GetDirectoryName(final)!);
+        try
+        {
+            onStaging?.Invoke(stageDir);
+        }
+        catch
+        {
+            OutputCommit.TryDelete(stageDir);
+            throw;
+        }
+        var staged = Path.Combine(stageDir, Path.GetFileName(final));
+        OutputCommit.Track(staged, final);
+        lock (_entries)
+            _entries.Add(new Entry(final, stageDir, staged));
+        return staged;
+    }
+
+    /// <summary>
+    /// Moves the staged outputs in <paramref name="produced"/> (in the order they were allocated) and their side files
+    /// into place, adding every final path to <paramref name="outputs"/> right after it was moved. Throws
+    /// <see cref="OutputCommitException"/> at the first path that can't be moved; the paths before it stay in place.
+    /// </summary>
+    public void Commit(IReadOnlyList<string> produced, List<string> outputs, OutputRule rule, IReadOnlyList<string> sources,
+        Action<string> release)
+    {
+        List<Entry> entries;
+        lock (_entries)
+        {
+            entries = [.. _entries];
+            _entries.Clear();
+        }
+        foreach (var entry in entries)
+            OutputCommit.Untrack(entry.Staged);
+        var wanted = produced.ToHashSet(StringComparer.Ordinal);
+        var overwrite = rule.Conflict == ConflictPolicy.Overwrite;
+        try
+        {
+            for (var i = 0; i < entries.Count; i++)
+            {
+                var entry = entries[i];
+                if (!wanted.Contains(entry.Staged) || !(File.Exists(entry.Staged) || Directory.Exists(entry.Staged)))
+                {
+                    // Allocated but not written (or not reported): nothing to keep.
+                    release(entry.Final);
+                    OutputCommit.TryDelete(entry.StageDir);
+                    entries[i] = entry with { StageDir = "" };
+                    continue;
+                }
+                OutputCommit.Move(entry.Staged, entry.Final, overwrite, sources);
+                outputs.Add(entry.Final);
+                // Side files named after the output (Pandoc "<name>_files", Markdown images) go next to it.
+                var folder = Path.GetDirectoryName(entry.Final)!;
+                foreach (var side in Directory.EnumerateFileSystemEntries(entry.StageDir))
+                    OutputCommit.Move(side, Path.Combine(folder, Path.GetFileName(side)), overwrite, sources);
+                OutputCommit.TryDelete(entry.StageDir);
+                entries[i] = entry with { StageDir = "" };
+            }
+        }
+        finally
+        {
+            foreach (var entry in entries.Where(e => e.StageDir.Length > 0))
+            {
+                release(entry.Final);
+                OutputCommit.TryDelete(entry.StageDir);
+            }
+        }
+    }
+
+    /// <summary>Deletes everything not committed and releases its reserved final paths.</summary>
+    public void Abort(Action<string> release)
+    {
+        List<Entry> entries;
+        lock (_entries)
+        {
+            entries = [.. _entries];
+            _entries.Clear();
+        }
+        foreach (var entry in entries)
+        {
+            OutputCommit.Untrack(entry.Staged);
+            release(entry.Final);
+            OutputCommit.TryDelete(entry.StageDir);
+        }
+    }
+}
