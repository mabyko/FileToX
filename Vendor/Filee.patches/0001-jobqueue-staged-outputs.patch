+using System.Security.Cryptography;
+using System.Text;
+using Filee.Core.Conversion;
+using Filee.Core.Presets;
+
+namespace Filee.Core.Tests;
+
+/// <summary>Final outputs are staged next to their final path and moved into place only after a conversion worked.</summary>
+public class JobQueueStagingTests
+{
+    /// <summary>Converter whose behaviour is a delegate over (step, allocator).</summary>
+    private sealed class ScriptedConverter(Func<ConversionStep, IReadOnlyList<string>> run, params ConversionEdge[] edges) : IConverter
+    {
+        public string Id => "scripted";
+        public string DisplayName => "scripted";
+        public IReadOnlyList<ConversionEdge> Edges => edges;
+        public int MaxParallelism => 0;
+        public EngineStatus GetStatus() => EngineStatus.Available();
+
+        public Task<IReadOnlyList<string>> ConvertAsync(ConversionStep step, IProgress<double>? progress, CancellationToken cancellationToken) =>
+            Task.FromResult(run(step));
+    }
+
+    private static async Task<ConversionJob> Run(IConverter converter, IReadOnlyList<string> sources, Preset preset, List<string>? staged = null)
+    {
+        await using var queue = new JobQueue(new ConverterCatalog([converter]), onStaging: staged is null ? null : staged.Add);
+        var job = new ConversionJob(sources, preset, "Test");
+        await queue.RunAsync(job);
+        return job;
+    }
+
+    private static string Write(string path, string text)
+    {
+        File.WriteAllText(path, text);
+        return path;
+    }
+
+    private static string Hash(string path) => Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(path)));
+
+    private static string[] Leftovers(string dir) =>
+        Directory.GetFileSystemEntries(dir, ".filee-out-*", SearchOption.AllDirectories);
+
+    [Fact]
+    public async Task Failure_after_some_pages_leaves_no_output_and_releases_the_names()
+    {
+        using var dir = new TempDir();
+        var source = dir.File("doc.pdf");
+        var fail = true;
+        var converter = new ScriptedConverter(step =>
+        {
+            var written = new List<string>();
+            for (var page = 1; page <= 3; page++)
+            {
+                if (page == 3 && fail)
+                    throw new InvalidOperationException("boom");
+                written.Add(Write(step.Output.Allocate("png", $"_p{page}")!, "page"));
+            }
+            return written;
+        }, new ConversionEdge("pdf", "png"));
+
+        var staged = new List<string>();
+        var job = await Run(converter, [source], new Preset { TargetFormat = "png" }, staged);
+
+        Assert.Equal(FileState.Failed, job.Files[0].State);
+        Assert.Empty(job.Files[0].Outputs);
+        Assert.Empty(Directory.GetFiles(dir.Path, "doc_p*"));
+        Assert.Empty(Leftovers(dir.Path));
+        Assert.Equal(2, staged.Count);
+        Assert.All(staged, s => Assert.StartsWith(OutputCommit.StagingPrefix, Path.GetFileName(s)));
+
+        fail = false;
+        var again = await Run(converter, [source], new Preset { TargetFormat = "png" });
+        Assert.Equal([Path.Combine(dir.Path, "doc_p1.png"), Path.Combine(dir.Path, "doc_p2.png"), Path.Combine(dir.Path, "doc_p3.png")],
+            again.Files[0].Outputs);
+    }
+
+    [Fact]
+    public async Task A_failed_overwrite_keeps_the_existing_file()
+    {
+        using var dir = new TempDir();
+        var source = dir.File("a.jpg");
+        var existing = dir.File("a.png", "old");
+        var before = Hash(existing);
+        var converter = new ScriptedConverter(step =>
+        {
+            Write(step.Output.Allocate("png")!, "half");
+            throw new InvalidOperationException("boom");
+        }, new ConversionEdge("jpg", "png"));
+
+        var job = await Run(converter, [source], new Preset { TargetFormat = "png", Output = { Conflict = ConflictPolicy.Overwrite } });
+
+        Assert.Equal(FileState.Failed, job.Files[0].State);
+        Assert.Equal(before, Hash(existing));
+        Assert.Empty(Leftovers(dir.Path));
+    }
+
+    [Fact]
+    public async Task Overwrite_replaces_the_existing_file_after_success()
+    {
+        using var dir = new TempDir();
+        var source = dir.File("a.jpg");
+        var existing = dir.File("a.png", "old");
+        var converter = new ScriptedConverter(step => [Write(step.Output.Allocate("png")!, "new")], new ConversionEdge("jpg", "png"));
+
+        var job = await Run(converter, [source], new Preset { TargetFormat = "png", Output = { Conflict = ConflictPolicy.Overwrite } });
+
+        Assert.Equal(FileState.Done, job.Files[0].State);
+        Assert.Equal([existing], job.Files[0].Outputs);
+        Assert.Equal("new", File.ReadAllText(existing));
+    }
+
+    [Fact]
+    public async Task Side_files_named_after_the_output_land_next_to_it()
+    {
+        using var dir = new TempDir();
+        var source = dir.File("x.docx");
+        var converter = new ScriptedConverter(step =>
+        {
+            var output = step.Output.Allocate("html")!;
+            Assert.Equal(Path.Combine(dir.Path, "x.html"), OutputCommit.FinalPathOf(output));
+            var media = Path.Combine(Path.GetDirectoryName(output)!, Path.GetFileNameWithoutExtension(output) + "_files");
+            Directory.CreateDirectory(media);
+            Write(Path.Combine(media, "img.png"), "img");
+            return [Write(output, "<img src=\"x_files/img.png\">")];
+        }, new ConversionEdge("docx", "html"));
+
+        var job = await Run(converter, [source], new Preset { TargetFormat = "html" });
+
+        Assert.Equal([Path.Combine(dir.Path, "x.html")], job.Files[0].Outputs);
+        Assert.True(File.Exists(Path.Combine(dir.Path, "x_files", "img.png")));
+        Assert.Equal("/elsewhere/y.html", OutputCommit.FinalPathOf("/elsewhere/y.html"));
+        Assert.Empty(Leftovers(dir.Path));
+    }
+
+    [Fact]
+    public async Task When_the_second_output_cannot_be_moved_the_first_is_reported()
+    {
+        using var dir = new TempDir();
+        var source = dir.File("s.pdf");
+        Directory.CreateDirectory(Path.Combine(dir.Path, "s_p2.png")); // a folder in the way of page 2
+        var converter = new ScriptedConverter(step =>
+        [
+            Write(step.Output.Allocate("png", "_p1")!, "1"),
+            Write(step.Output.Allocate("png", "_p2")!, "2"),
+        ], new ConversionEdge("pdf", "png"));
+
+        var job = await Run(converter, [source], new Preset { TargetFormat = "png", Output = { Conflict = ConflictPolicy.Overwrite } });
+
+        Assert.Equal(FileState.Failed, job.Files[0].State);
+        Assert.Equal([Path.Combine(dir.Path, "s_p1.png")], job.Files[0].Outputs);
+        Assert.Equal("error.output_commit_failed", job.Files[0].ErrorKey);
+        Assert.True(Directory.Exists(Path.Combine(dir.Path, "s_p2.png")));
+        Assert.Empty(Leftovers(dir.Path));
+    }
+
+    [Fact]
+    public async Task A_file_made_by_someone_else_meanwhile_is_not_overwritten()
+    {
+        using var dir = new TempDir();
+        var source = dir.File("a.jpg");
+        var converter = new ScriptedConverter(step =>
+        {
+            var output = step.Output.Allocate("png")!;
+            Write(Path.Combine(dir.Path, "a.png"), "theirs");
+            return [Write(output, "ours")];
+        }, new ConversionEdge("jpg", "png"));
+
+        var job = await Run(converter, [source], new Preset { TargetFormat = "png" });
+
+        Assert.Equal(FileState.Failed, job.Files[0].State);
+        Assert.Equal("error.output_exists", job.Files[0].ErrorKey);
+        Assert.Equal("theirs", File.ReadAllText(Path.Combine(dir.Path, "a.png")));
+        Assert.Empty(job.Files[0].Outputs);
+    }
+
+    [Fact]
+    public async Task Overwrite_never_replaces_a_source_reached_through_another_path()
+    {
+        if (!OperatingSystem.IsMacOS())
+            return; // inode comparison is macOS only; elsewhere the resolver's own path check applies
+        using var dir = new TempDir();
+        var name = "한글.txt".Normalize(NormalizationForm.FormC);
+        var source = dir.File(name, "original");
+        var alias = Path.Combine(dir.Path, "alias");
+        Directory.CreateSymbolicLink(alias, dir.Path);
+        var before = Hash(source);
+        var converter = new ScriptedConverter(step => [Write(step.Output.Allocate("txt")!, "replaced")], new ConversionEdge("txt", "txt"));
+
+        var preset = new Preset
+        {
+            TargetFormat = BuiltInData.SameAsSource,
+            Output = { Location = OutputLocation.CustomFolder, CustomFolder = alias, Conflict = ConflictPolicy.Overwrite },
+        };
+        var job = await Run(converter, [source], preset);
+
+        Assert.Equal(FileState.Failed, job.Files[0].State);
+        Assert.Equal("error.output_is_source", job.Files[0].ErrorKey);
+        Assert.Equal(before, Hash(source));
+        Assert.Empty(Leftovers(dir.Path));
+    }
+
+    [Fact]
+    public async Task Overwriting_a_folder_merges_and_keeps_unrelated_files()
+    {
+        using var dir = new TempDir();
+        var source = dir.File("pack.zip");
+        var target = Directory.CreateDirectory(Path.Combine(dir.Path, "pack")).FullName;
+        Write(Path.Combine(target, "keep.txt"), "mine");
+        Write(Path.Combine(target, "same.txt"), "old");
+        var converter = new ScriptedConverter(step =>
+        {
+            var output = step.Output.Allocate("")!;
+            Directory.CreateDirectory(output);
+            Write(Path.Combine(output, "same.txt"), "new");
+            return [output];
+        }, new ConversionEdge("zip", "folder"));
+
+        var job = await Run(converter, [source], new Preset { TargetFormat = "folder", Output = { Conflict = ConflictPolicy.Overwrite } });
+
+        Assert.Equal(FileState.Done, job.Files[0].State);
+        Assert.Equal([target], job.Files[0].Outputs);
+        Assert.Equal("mine", File.ReadAllText(Path.Combine(target, "keep.txt")));
+        Assert.Equal("new", File.ReadAllText(Path.Combine(target, "same.txt")));
+        Assert.Empty(Leftovers(dir.Path));
+    }
+
+    [Fact]
+    public async Task Cancelling_before_the_commit_leaves_nothing()
+    {
+        using var dir = new TempDir();
+        var source = dir.File("a.jpg");
+        ConversionJob? job = null;
+        var converter = new ScriptedConverter(step =>
+        {
+            var output = Write(step.Output.Allocate("png")!, "x");
+            job!.Cancel();
+            return [output];
+        }, new ConversionEdge("jpg", "png"));
+
+        await using var queue = new JobQueue(new ConverterCatalog([converter]));
+        job = new ConversionJob([source], new Preset { TargetFormat = "png" }, "Test");
+        await queue.RunAsync(job);
+
+        Assert.Equal(JobState.Cancelled, job.State);
+        Assert.Equal(FileState.Cancelled, job.Files[0].State);
+        Assert.False(File.Exists(Path.Combine(dir.Path, "a.png")));
+        Assert.Empty(Leftovers(dir.Path));
+    }
+}
