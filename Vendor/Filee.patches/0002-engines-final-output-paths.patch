+    /// <summary>
+    /// Throws what <see cref="Move"/> would throw, without moving anything. Lets a caller refuse a conflict in a side
+    /// file before it publishes the output they belong to.
+    /// </summary>
+    public static void Check(string staged, string final, bool overwrite, IReadOnlyList<string> sources)
+    {
+        if (!Exists(final))
+            return;
+        CheckExisting(staged, final, overwrite, sources);
+        if (Directory.Exists(staged))
+            foreach (var entry in Directory.EnumerateFileSystemEntries(staged))
+                Check(entry, Path.Combine(final, Path.GetFileName(entry)), overwrite, sources);
+    }
+
+    private static void CheckExisting(string staged, string final, bool overwrite, IReadOnlyList<string> sources)
+    {
+        if (!overwrite)
+            throw new OutputCommitException("error.output_exists", $"{final} already exists.");
+        if (IsSource(final, sources))
+            throw new OutputCommitException("error.output_is_source", $"{final} is a source file of this job.");
+        if (Directory.Exists(staged) && (!Directory.Exists(final) || new DirectoryInfo(final).Attributes.HasFlag(FileAttributes.ReparsePoint)))
+            throw new OutputCommitException("error.output_exists", $"{final} is in the way of the extracted folder.");
+    }
