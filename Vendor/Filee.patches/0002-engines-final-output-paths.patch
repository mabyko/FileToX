diff --git c/tests/Filee.Engines.Tests/CancelEngineTests.cs i/tests/Filee.Engines.Tests/CancelEngineTests.cs
new file mode 100644
index 0000000..cfd4e0b
--- /dev/null
+++ i/tests/Filee.Engines.Tests/CancelEngineTests.cs
@@ -0,0 +1,48 @@
+// Cancelling a job while a real engine runs: the engine's processes end, nothing reaches the final folder and no
+// staging folder is left. Skipped when LibreOffice is not installed.
+
+using System.Diagnostics;
+using Filee.Core.Conversion;
+using Filee.Core.Presets;
+
+namespace Filee.Engines.Tests;
+
+public class CancelEngineTests(EngineFixture fx) : IClassFixture<EngineFixture>
+{
+    [Fact]
+    public async Task Cancelling_LibreOffice_stops_every_process_and_publishes_nothing()
+    {
+        Assert.SkipUnless(fx.Catalog.StatusOf(fx.Converters.Single(c => c.Id == "libreoffice")).IsAvailable, "LibreOffice not installed");
+        var dir = fx.NewFolder();
+        var source = Path.Combine(dir, "doc.rtf");
+        await File.WriteAllTextAsync(source, "{\\rtf1\\ansi Hello}", TestContext.Current.CancellationToken);
+        Assert.Equal("libreoffice", fx.Catalog.CreatePlanner().Plan("rtf", "pdf")!.Steps.Single().Converter.Id);
+
+        await using var queue = new JobQueue(fx.Catalog);
+        var job = new ConversionJob([source], new Preset { TargetFormat = "pdf" }, "Test");
+        var run = queue.RunAsync(job);
+        // Wait until LibreOffice runs (its profile folder lives under this fixture's data folder).
+        var deadline = DateTime.UtcNow.AddSeconds(30);
+        while (!Running() && DateTime.UtcNow < deadline && !run.IsCompleted)
+            await Task.Delay(50, TestContext.Current.CancellationToken);
+        Assert.True(Running(), "LibreOffice never started");
+        job.Cancel();
+        await run.WaitAsync(TimeSpan.FromSeconds(30), TestContext.Current.CancellationToken);
+
+        Assert.Equal(JobState.Cancelled, job.State);
+        Assert.False(File.Exists(Path.Combine(dir, "doc.pdf")));
+        Assert.Empty(Directory.GetFileSystemEntries(dir, ".filee-out-*", SearchOption.AllDirectories));
+        for (var i = 0; i < 40 && Running(); i++)
+            await Task.Delay(100, TestContext.Current.CancellationToken);
+        Assert.False(Running(), "a LibreOffice process survived the cancel");
+    }
+
+    private bool Running()
+    {
+        using var pgrep = Process.Start(new ProcessStartInfo("/usr/bin/pgrep", ["-f", Path.Combine(fx.Root, "data")])
+            { RedirectStandardOutput = true, UseShellExecute = false })!;
+        pgrep.StandardOutput.ReadToEnd();
+        pgrep.WaitForExit();
+        return pgrep.ExitCode == 0;
+    }
+}
