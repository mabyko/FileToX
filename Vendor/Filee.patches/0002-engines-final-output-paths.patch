+++ i/tests/Filee.Engines.Tests/PandocStagingTests.cs
@@ -0,0 +1,98 @@
+// Pandoc's extracted media ("<name>_files") is staged with the output and committed with it: never written into the
+// final folder while converting, linked relatively, and not published when it conflicts. Skipped when Pandoc is not
+// installed.
+
+using Filee.Core.Conversion;
+using Filee.Core.Presets;
+using ImageMagick;
+
+namespace Filee.Engines.Tests;
+
+public class PandocStagingTests(EngineFixture fx) : IClassFixture<EngineFixture>
+{
+    private void SkipUnlessInstalled() =>
+        Assert.SkipUnless(fx.Catalog.StatusOf(fx.Converters.Single(c => c.Id == "pandoc")).IsAvailable, "Pandoc not installed");
+
+    /// <summary>A DOCX with one picture, in a folder of its own.</summary>
+    private async Task<string> DocxWithPictureAsync()
+    {
+        var dir = fx.NewFolder();
+        using (var chart = new MagickImage(MagickColors.Teal, 160, 90))
+            chart.Write(Path.Combine(dir, "chart.png"));
+        await File.WriteAllTextAsync(Path.Combine(dir, "doc.md"), "# Title\n\n![chart](chart.png)\n", TestContext.Current.CancellationToken);
+        var job = await fx.ConvertAsync([Path.Combine(dir, "doc.md")], new Preset { TargetFormat = "docx" });
+        Assert.True(job.State == JobState.Completed, string.Join("; ", job.Files.Select(f => $"{f.ErrorKey} {f.ErrorDetail}")));
+        var docx = Path.Combine(dir, "doc.docx");
+        Assert.Contains(docx, job.Outputs);
+        File.Delete(Path.Combine(dir, "doc.md"));
+        File.Delete(Path.Combine(dir, "chart.png"));
+        return docx;
+    }
+
+    private Task<ConversionJob> ToMarkdownAsync(string docx, string outFolder, ConflictPolicy conflict) =>
+        fx.ConvertAsync([docx], new Preset
+        {
+            TargetFormat = "md",
+            Output = { Location = OutputLocation.CustomFolder, CustomFolder = outFolder, Conflict = conflict },
+        });
+
+    private static string[] Leftovers(string dir) => Directory.GetFileSystemEntries(dir, ".filee-out-*", SearchOption.AllDirectories);
+
+    [Fact]
+    public async Task Media_is_staged_committed_next_to_the_output_and_linked_relatively()
+    {
+        SkipUnlessInstalled();
+        var docx = await DocxWithPictureAsync();
+        var outFolder = fx.NewFolder();
+
+        var job = await ToMarkdownAsync(docx, outFolder, ConflictPolicy.Rename);
+
+        Assert.True(job.State == JobState.Completed, string.Join("; ", job.Files.Select(f => $"{f.ErrorKey} {f.ErrorDetail}")));
+        var md = Assert.Single(job.Outputs);
+        Assert.Equal(Path.Combine(outFolder, "doc.md"), md);
+        var link = System.Text.RegularExpressions.Regex.Match(await File.ReadAllTextAsync(md, TestContext.Current.CancellationToken),
+            "src=\"(doc_files/[^\"]+)\"|\\]\\((doc_files/[^)]+)\\)");
+        Assert.True(link.Success, "no relative media link");
+        Assert.True(File.Exists(Path.Combine(outFolder, link.Groups[1].Value + link.Groups[2].Value)));
+        // Nothing went next to the source, and no staging folder is left.
+        Assert.False(Directory.Exists(Path.Combine(Path.GetDirectoryName(docx)!, "doc_files")));
+        Assert.Empty(Leftovers(outFolder));
+        Assert.Empty(Leftovers(Path.GetDirectoryName(docx)!));
+    }
+
+    [Fact]
+    public async Task A_media_folder_in_the_way_is_not_touched_and_nothing_is_published()
+    {
+        SkipUnlessInstalled();
+        var docx = await DocxWithPictureAsync();
+        var outFolder = fx.NewFolder();
+        var theirs = Directory.CreateDirectory(Path.Combine(outFolder, "doc_files", "media")).FullName;
+        await File.WriteAllTextAsync(Path.Combine(theirs, "rId9.png"), "mine", TestContext.Current.CancellationToken);
+
+        var job = await ToMarkdownAsync(docx, outFolder, ConflictPolicy.Rename);
+
+        Assert.Equal(FileState.Failed, job.Files[0].State);
+        Assert.Equal("error.output_exists", job.Files[0].ErrorKey);
+        Assert.False(File.Exists(Path.Combine(outFolder, "doc.md")));
+        Assert.Equal("mine", await File.ReadAllTextAsync(Path.Combine(theirs, "rId9.png"), TestContext.Current.CancellationToken));
+        Assert.Equal(["rId9.png"], Directory.GetFileSystemEntries(theirs).Select(Path.GetFileName));
+        Assert.Empty(Leftovers(outFolder));
+    }
+
+    [Fact]
+    public async Task Overwriting_merges_the_media_folder_and_keeps_unrelated_files()
+    {
+        SkipUnlessInstalled();
+        var docx = await DocxWithPictureAsync();
+        var outFolder = fx.NewFolder();
+        var media = Directory.CreateDirectory(Path.Combine(outFolder, "doc_files")).FullName;
+        await File.WriteAllTextAsync(Path.Combine(media, "keep.txt"), "mine", TestContext.Current.CancellationToken);
+
+        var job = await ToMarkdownAsync(docx, outFolder, ConflictPolicy.Overwrite);
+
+        Assert.True(job.State == JobState.Completed, string.Join("; ", job.Files.Select(f => $"{f.ErrorKey} {f.ErrorDetail}")));
+        Assert.Equal("mine", await File.ReadAllTextAsync(Path.Combine(media, "keep.txt"), TestContext.Current.CancellationToken));
+        Assert.NotEmpty(Directory.GetFiles(Path.Combine(media, "media")));
+        Assert.Empty(Leftovers(outFolder));
+    }
+}
