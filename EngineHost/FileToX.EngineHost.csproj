<!--
  FileToX engine host: handles conversion jobs for the SwiftUI app over NDJSON on stdio (docs/design/engine-host.md,
  docs/design/host-wire-v1.md). References the patched Filee sources staged by Tools/build-engine-host.sh.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FileToXEngine</AssemblyName>
    <RootNamespace>FileToX.EngineHost</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <FileeSource Condition="'$(FileeSource)' == ''">$(MSBuildThisFileDirectory)../build/filee-src</FileeSource>
    <FileeCommit>21fdd05ef7181b032ed83ec895cc9bbc4b198985</FileeCommit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(FileeSource)/src/Filee.Core/Filee.Core.csproj" />
    <ProjectReference Include="$(FileeSource)/src/Filee.Engines/Filee.Engines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(FileeSource)/src/Filee.App/Assets/i18n/*.json" LogicalName="i18n.%(Filename).json" />
    <EmbeddedResource Include="i18n/*.json" LogicalName="i18n.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FileeCommit</_Parameter1>
      <_Parameter2>$(FileeCommit)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
